generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  @@map("users")
}

model Prenotazione {
  id        Int    @id @default(autoincrement())
  date      String
  user      String
  tipo      String
  groupId   String @default("")
  status    String @default("PENDING")
  userEmail String @default("")

  @@map("prenotazioni")
}

model Servizio {
  id          Int     @id @default(autoincrement())
  nome        String
  descrizione String
  immagine    String
  incluso     Boolean @default(true)

  @@map("servizi")
}

model Photo {
  id  Int    @id @default(autoincrement())
  url String

  @@map("photos")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderType String
  senderName String
  userEmail  String?
  content    String
  createdAt  DateTime @default(now())

  @@map("messages")
}
